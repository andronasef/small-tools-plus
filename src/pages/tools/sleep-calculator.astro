---
import { tools } from '../../data/tools';
const tool = tools.find((t) => t.id === 'sleep-calculator')!;
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{tool.title}</title>
  <link rel="icon" type="image/svg+xml" href={`/icons/${tool.iconFile}`}>
  <!-- PWA & Mobile Web App Meta -->
  <link rel="manifest" href={`/${tool.manifest}`}>
  <meta name="theme-color" content={tool.accentColor}>
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <link rel="apple-touch-icon" href={`/icons/${tool.iconFile.replace('.svg', '-192.png')}`}>

  <link rel="stylesheet" href="/style.css">
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

  <script is:inline>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            sleepCanvas: '#0a0a0c',
            sleepCard: '#121216',
            sleepElevated: '#18181f',
            sleepBorder: '#24242e',
            sleepGold: '#FFDD88',
          }
        }
      }
    };
  </script>

  <style is:inline>
    body {
      background-color: #0a0a0c;
      color: #f4f4f6;
      font-family: 'Inter', sans-serif;
    }
    .cycle-card {
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .cycle-card:hover {
      transform: translateY(-2px);
    }
    .glow-gold {
      box-shadow: 0 0 25px -4px rgba(255, 221, 136, 0.25);
    }
    .glow-indigo {
      box-shadow: 0 0 25px -4px rgba(99, 102, 241, 0.3);
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-indigo-500/30 selection:text-white">

  <!-- Top Navigation Bar -->
  <header class="border-b border-sleepBorder bg-sleepCard/80 backdrop-blur-md sticky top-0 z-30">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-4">
      
      <!-- Brand & Title -->
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2.5 text-inherit no-underline">
          <div class="w-8 h-8 rounded-lg bg-indigo-500/10 border border-indigo-500/30 flex items-center justify-center text-indigo-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
          </div>
          <span class="font-bold text-sm tracking-tight text-white hidden sm:inline">Sleep Calculator</span>
        </a>
      </div>

      <!-- Action Controls -->
      <div class="flex items-center gap-2">
        <button id="pwaInstallToolBtn" onclick="triggerToolPwaInstall()" class="stp-install-btn" style="display:none;background:#6366f1" title="Install Sleep Calculator as App">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
          <span>Install App 📲</span>
        </button>

        <a href="/" class="stp-nav-back" title="Back to Tools Directory">
          <span>← All Tools</span>
          <span class="stp-badge">stp://</span>
        </a>
      </div>

    </div>
  </header>

  <!-- Main Content -->
  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12 flex-1 w-full">
    
    <!-- Hero / Moon Logo -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center mb-4">
        <div class="relative w-16 h-16 rounded-2xl bg-gradient-to-tr from-indigo-950 via-sleepElevated to-sleepCard border border-indigo-500/30 flex items-center justify-center shadow-lg shadow-indigo-950/50">
          <svg class="w-8 h-8 text-[#FFDD88]" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"/>
          </svg>
          <span class="absolute -top-1 -right-1 flex h-3 w-3">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-amber-500"></span>
          </span>
        </div>
      </div>
      
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white mb-2">
        Sleep Calculator
      </h1>
      <p class="text-zinc-400 text-sm sm:text-base max-w-xl mx-auto">
        Calculate the optimal times to fall asleep or wake up based on 90-minute natural sleep cycles.
      </p>
    </div>

    <!-- Mode Selector Tabs -->
    <div class="flex justify-center mb-8">
      <div class="inline-flex p-1 bg-sleepCard border border-sleepBorder rounded-xl shadow-sm">
        <button 
          id="tabNow" 
          onclick="setMode('now')" 
          class="px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold transition bg-indigo-600 text-white shadow-sm"
        >
          🌙 Sleep Now
        </button>
        <button 
          id="tabWake" 
          onclick="setMode('wake')" 
          class="px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold transition text-zinc-400 hover:text-white"
        >
          ⏰ Plan Wake Up Time
        </button>
      </div>
    </div>

    <!-- Panel 1: Sleep Now -->
    <section id="panelNow" class="space-y-6">
      <div class="bg-sleepCard border border-sleepBorder rounded-2xl p-5 sm:p-6 text-center">
        <div class="inline-flex items-center gap-2 text-xs font-mono text-zinc-400 mb-2 px-3 py-1 rounded-full bg-sleepElevated border border-sleepBorder">
          <span>Current Time:</span>
          <span id="currentTimeDisplay" class="font-bold text-indigo-400">--:--:--</span>
        </div>
        <p class="text-sm sm:text-base text-zinc-300 max-w-2xl mx-auto leading-relaxed">
          The average person takes <strong class="text-white">15 minutes</strong> to fall asleep. If you go to bed right now, try to wake up at one of these times:
        </p>
      </div>

      <!-- Sleep Now Results Grid -->
      <div id="sleepNowResults" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- Rendered by JS -->
      </div>
    </section>

    <!-- Panel 2: Plan Wake Up -->
    <section id="panelWake" class="hidden space-y-6">
      <div class="bg-sleepCard border border-sleepBorder rounded-2xl p-6 sm:p-8 text-center max-w-xl mx-auto">
        <label class="block text-xs uppercase tracking-wider font-bold text-zinc-400 mb-3">
          I want to wake up at:
        </label>
        
        <div class="flex items-center justify-center gap-3 mb-6">
          <input 
            type="time" 
            id="targetWakeTime" 
            value="07:00" 
            onchange="calculateBedtimes()"
            class="px-4 py-3 rounded-xl bg-sleepElevated border border-sleepBorder text-white text-xl font-mono font-bold focus:outline-none focus:border-indigo-500 transition cursor-pointer"
          />
          <button 
            onclick="calculateBedtimes()" 
            class="px-5 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 active:scale-95 text-white font-semibold text-sm transition shadow-sm"
          >
            Calculate
          </button>
        </div>

        <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed">
          To wake up feeling refreshed at your desired time, you should aim to fall asleep at one of these times:
        </p>
      </div>

      <!-- Plan Wake Up Results Grid -->
      <div id="planWakeResults" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- Rendered by JS -->
      </div>
    </section>

    <!-- Sleep Science Guide Block -->
    <section class="mt-12 bg-sleepCard border border-sleepBorder rounded-2xl p-6 sm:p-8">
      <h3 class="text-lg font-bold text-white mb-3 flex items-center gap-2">
        <span>💡 How Sleep Cycles Work</span>
      </h3>
      <p class="text-sm text-zinc-300 leading-relaxed mb-4">
        A regular sleep cycle lasts about <strong class="text-indigo-400 font-semibold">90 minutes</strong>, cycling through Light Sleep, Deep Sleep, and REM (Rapid Eye Movement).
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs text-zinc-400">
        <div class="p-4 rounded-xl bg-sleepElevated border border-sleepBorder">
          <span class="block font-semibold text-white mb-1">5 to 6 Cycles (Ideal)</span>
          Provides 7.5 to 9 hours of restorative sleep, matching the biological requirement for most adults.
        </div>
        <div class="p-4 rounded-xl bg-sleepElevated border border-sleepBorder">
          <span class="block font-semibold text-white mb-1">Avoid Sleep Inertia</span>
          Waking up mid-cycle (during deep sleep) causes grogginess and morning brain fog that can last hours.
        </div>
        <div class="p-4 rounded-xl bg-sleepElevated border border-sleepBorder">
          <span class="block font-semibold text-white mb-1">15-Minute Buffer</span>
          Calculations include 15 minutes of wind-down time needed on average to transition into sleep.
        </div>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer class="border-t border-sleepBorder py-6 text-center text-xs text-zinc-500 font-mono">
    <p>Offline-ready • 100% Client-side • Small Tools Plus</p>
  </footer>

  <script is:inline>
    let activeMode = 'now';

    function setMode(mode) {
      activeMode = mode;
      const tabNow = document.getElementById('tabNow');
      const tabWake = document.getElementById('tabWake');
      const panelNow = document.getElementById('panelNow');
      const panelWake = document.getElementById('panelWake');

      if (mode === 'now') {
        tabNow.className = 'px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold transition bg-indigo-600 text-white shadow-sm';
        tabWake.className = 'px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold transition text-zinc-400 hover:text-white';
        panelNow.classList.remove('hidden');
        panelWake.classList.add('hidden');
        renderSleepNow();
      } else {
        tabWake.className = 'px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold transition bg-indigo-600 text-white shadow-sm';
        tabNow.className = 'px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold transition text-zinc-400 hover:text-white';
        panelWake.classList.remove('hidden');
        panelNow.classList.add('hidden');
        calculateBedtimes();
      }
    }

    function formatTime(date) {
      let hours = date.getHours();
      const minutes = date.getMinutes();
      const ampm = hours >= 12 ? 'PM' : 'AM';
      hours = hours % 12;
      hours = hours ? hours : 12; // 0 should be 12
      const strMinutes = minutes < 10 ? '0' + minutes : minutes;
      return `${hours}:${strMinutes} ${ampm}`;
    }

    function renderSleepNow() {
      const now = new Date();
      const container = document.getElementById('sleepNowResults');
      if (!container) return;

      const cycles = [6, 5, 4, 3, 2, 1];
      let html = '';

      cycles.forEach((cycle) => {
        const wakeDate = new Date(now.getTime() + (cycle * 90 + 15) * 60000);
        const timeFormatted = formatTime(wakeDate);
        const hoursOfSleep = (cycle * 1.5).toFixed(1);
        const isSuggested = cycle >= 5;

        html += `
          <div class="cycle-card bg-sleepCard border ${isSuggested ? 'border-indigo-500/50 glow-indigo' : 'border-sleepBorder'} rounded-2xl p-5 flex flex-col justify-between relative overflow-hidden">
            ${isSuggested ? `
              <div class="absolute top-3 right-3 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-amber-400/20 text-[#FFDD88] border border-amber-400/30">
                ★ Suggested
              </div>
            ` : ''}
            <div>
              <span class="text-xs font-mono text-zinc-400 block mb-1">
                ${cycle} Cycles (${hoursOfSleep} hrs)
              </span>
              <div class="text-3xl font-extrabold font-mono text-white tracking-tight my-1 ${isSuggested ? 'text-indigo-300' : ''}">
                ${timeFormatted}
              </div>
            </div>
            <div class="mt-3 pt-3 border-t border-sleepBorder/60 flex items-center justify-between text-xs text-zinc-400">
              <span>${isSuggested ? 'Optimal restorative sleep' : 'Quick rest'}</span>
              <span class="font-mono text-[11px] text-zinc-500">${cycle * 90}m sleep</span>
            </div>
          </div>
        `;
      });

      container.innerHTML = html;
    }

    function calculateBedtimes() {
      const input = document.getElementById('targetWakeTime');
      const container = document.getElementById('planWakeResults');
      if (!input || !container) return;

      const [hours, minutes] = input.value.split(':').map(Number);
      const targetDate = new Date();
      targetDate.setHours(hours, minutes, 0, 0);

      const cycles = [6, 5, 4, 3, 2, 1];
      let html = '';

      cycles.forEach((cycle) => {
        const bedDate = new Date(targetDate.getTime() - (cycle * 90 + 15) * 60000);
        const timeFormatted = formatTime(bedDate);
        const hoursOfSleep = (cycle * 1.5).toFixed(1);
        const isSuggested = cycle >= 5;

        html += `
          <div class="cycle-card bg-sleepCard border ${isSuggested ? 'border-indigo-500/50 glow-indigo' : 'border-sleepBorder'} rounded-2xl p-5 flex flex-col justify-between relative overflow-hidden">
            ${isSuggested ? `
              <div class="absolute top-3 right-3 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-amber-400/20 text-[#FFDD88] border border-amber-400/30">
                ★ Suggested
              </div>
            ` : ''}
            <div>
              <span class="text-xs font-mono text-zinc-400 block mb-1">
                ${cycle} Cycles (${hoursOfSleep} hrs)
              </span>
              <div class="text-3xl font-extrabold font-mono text-white tracking-tight my-1 ${isSuggested ? 'text-indigo-300' : ''}">
                ${timeFormatted}
              </div>
            </div>
            <div class="mt-3 pt-3 border-t border-sleepBorder/60 flex items-center justify-between text-xs text-zinc-400">
              <span>Go to bed at ${timeFormatted}</span>
              <span class="font-mono text-[11px] text-zinc-500">+15m to fall asleep</span>
            </div>
          </div>
        `;
      });

      container.innerHTML = html;
    }

    function updateLiveClock() {
      const now = new Date();
      const el = document.getElementById('currentTimeDisplay');
      if (el) {
        el.textContent = now.toLocaleTimeString();
      }
    }

    // PWA Standalone Install Trigger
    let toolInstallPrompt = null;
    const pwaInstallToolBtn = document.getElementById('pwaInstallToolBtn');
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      toolInstallPrompt = e;
      if (pwaInstallToolBtn) {
        pwaInstallToolBtn.classList.remove('hidden');
        pwaInstallToolBtn.style.display = 'inline-flex';
      }
    });

    function triggerToolPwaInstall() {
      if (!toolInstallPrompt) return;
      toolInstallPrompt.prompt();
      toolInstallPrompt.userChoice.then((choice) => {
        if (choice.outcome === 'accepted' && pwaInstallToolBtn) {
          pwaInstallToolBtn.style.display = 'none';
        }
        toolInstallPrompt = null;
      });
    }

    window.addEventListener('DOMContentLoaded', () => {
      renderSleepNow();
      updateLiveClock();
      setInterval(updateLiveClock, 1000);
      // Re-render sleep now times every 60 seconds
      setInterval(() => {
        if (activeMode === 'now') renderSleepNow();
      }, 60000);

      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(() => {});
      }
    });
  </script>
</body>
</html>
