---
import { tools } from '../../data/tools';
const tool = tools.find((t) => t.id === 'sleep-calculator')!;
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{tool.title}</title>
  <link rel="icon" type="image/svg+xml" href={`/icons/${tool.iconFile}`}>
  <!-- PWA & Mobile Web App Meta -->
  <link rel="manifest" href={`/${tool.manifest}`}>
  <meta name="theme-color" content={tool.accentColor}>
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <link rel="apple-touch-icon" href={`/icons/${tool.iconFile.replace('.svg', '-192.png')}`}>

  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/tailwind.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

  <style is:inline>
    body {
      background-color: #0b1120;
      color: #f4f4f6;
      font-family: 'Inter', sans-serif;
    }
    .sleep-btn {
      transition: all 0.15s ease-out;
    }
    .sleep-btn:hover {
      transform: translateY(-1px);
    }
    .sleep-btn.selected {
      border-color: #6366f1;
      box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.4);
      background-color: #1a2544;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-indigo-500/30 selection:text-white">

  <!-- Top Navigation Bar -->
  <header class="border-b border-slate-800/80 bg-[#0b1120]/90 backdrop-blur-md sticky top-0 z-30">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-4">
      
      <!-- Brand & Title -->
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2.5 text-inherit no-underline">
          <div class="w-8 h-8 rounded-lg bg-indigo-500/10 border border-indigo-500/30 flex items-center justify-center text-indigo-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
          </div>
          <span class="font-bold text-sm tracking-tight text-white hidden sm:inline">Sleep Calculator</span>
        </a>
      </div>

      <!-- Action Controls -->
      <div class="flex items-center gap-2">
        <button id="pwaInstallToolBtn" onclick="triggerToolPwaInstall()" class="stp-install-btn" style="display:none;background:#6366f1" title="Install Sleep Calculator as App">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
          <span>Install App 📲</span>
        </button>

        <a href="/" class="stp-nav-back" title="Back to Tools Directory">
          <span>← All Tools</span>
          <span class="stp-badge">stp://</span>
        </a>
      </div>

    </div>
  </header>

  <!-- Main Content -->
  <main class="max-w-2xl mx-auto px-4 sm:px-6 py-8 sm:py-12 flex-1 w-full">
    
    <!-- Moon Icon Header -->
    <div class="text-center mb-6">
      <div class="inline-flex items-center justify-center mb-4">
        <div class="w-12 h-12 rounded-2xl bg-indigo-950/60 border border-indigo-500/20 flex items-center justify-center shadow-lg shadow-indigo-950/40">
          <svg class="w-6 h-6 text-[#FFDD88]" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"/>
          </svg>
        </div>
      </div>
      
      <!-- Primary Simple Intro (Image 2 style) -->
      <p class="text-base sm:text-lg font-medium text-white mb-1.5 leading-snug">
        The average human takes 15 minutes to fall asleep.
      </p>
      <p class="text-sm sm:text-base text-zinc-300 leading-snug">
        If you go to sleep right now, you should try to wake up at one of the following times:
      </p>
    </div>

    <!-- The 2-Column Sleep Times Grid (Exactly like Image 2) -->
    <div id="sleepTimesGrid" class="grid grid-cols-2 gap-3 sm:gap-4 my-6">
      <!-- Generated dynamically by renderSleepNow() -->
    </div>

    <!-- Explanation Paragraph (Image 2 style) -->
    <p class="text-center text-xs sm:text-sm text-zinc-300 leading-relaxed mb-6">
      If you wake up at one of these times, you’ll rise in between 90-minute sleep cycles. A good night’s sleep consists of 5-6 complete sleep cycles.
    </p>

    <!-- Interactive Selection Details Box (Appears when clicking any card) -->
    <div id="selectionDetailBox" class="hidden mb-6 p-4 rounded-xl bg-[#131b2e] border border-indigo-500/30 text-center transition-all">
      <div class="flex items-center justify-between text-xs font-mono text-indigo-300 mb-1">
        <span id="detailCycles">6 Cycles</span>
        <span id="detailHours">9.0 Hours of Sleep</span>
      </div>
      <div id="detailDescription" class="text-sm font-medium text-white">
        Optimal restorative sleep — wake up in light REM sleep feeling energized and alert.
      </div>
    </div>

    <!-- Toggle Button to reveal More Data / Custom Planner / Science -->
    <div class="text-center mb-6">
      <button 
        id="toggleMoreDataBtn" 
        type="button" 
        onclick="toggleMoreData()" 
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-medium bg-[#131b2e] hover:bg-[#1a2544] text-zinc-300 border border-slate-700/60 hover:border-indigo-500/40 transition shadow-sm"
      >
        <span id="moreDataIcon">▾</span>
        <span id="moreDataText">Plan Custom Wake Time & More Data</span>
      </button>
    </div>

    <!-- Expandable "More Data" Section -->
    <div id="moreDataSection" class="hidden space-y-8 pt-4 border-t border-slate-800">
      
      <!-- Custom Wake Time Planner -->
      <section class="bg-[#131b2e] border border-slate-800 rounded-2xl p-6 text-center">
        <h3 class="text-sm uppercase tracking-wider font-bold text-zinc-300 mb-2">
          ⏰ Plan When to Sleep
        </h3>
        <p class="text-xs text-zinc-400 mb-4">
          I want to wake up at:
        </p>

        <div class="flex items-center justify-center gap-3 mb-6">
          <input 
            type="time" 
            id="targetWakeTime" 
            value="07:00" 
            onchange="calculateBedtimes()"
            class="px-4 py-2.5 rounded-xl bg-[#0b1120] border border-slate-700 text-white text-lg font-mono font-bold focus:outline-none focus:border-indigo-500 transition cursor-pointer"
          />
          <button 
            type="button"
            onclick="calculateBedtimes()" 
            class="px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 active:scale-95 text-white font-semibold text-xs sm:text-sm transition shadow-sm"
          >
            Calculate Bedtimes
          </button>
        </div>

        <p class="text-xs text-zinc-400 mb-4">
          To wake up refreshed at that time, aim to fall asleep at one of these times:
        </p>

        <!-- Bedtimes 2-Column Grid -->
        <div id="bedtimesGrid" class="grid grid-cols-2 gap-3 sm:gap-4 text-left">
          <!-- Rendered by calculateBedtimes() -->
        </div>
      </section>

      <!-- Sleep Cycles Science Guide -->
      <section class="bg-[#131b2e] border border-slate-800 rounded-2xl p-6">
        <h3 class="text-sm font-bold text-white mb-3 flex items-center gap-2">
          <span>💡 The 90-Minute Sleep Cycle Science</span>
        </h3>
        <p class="text-xs text-zinc-300 leading-relaxed mb-4">
          Human sleep naturally proceeds in cycles of approximately <strong class="text-indigo-400">90 minutes</strong> each, transitioning through Light Sleep, Deep Sleep, and REM.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs text-zinc-400 font-mono">
          <div class="p-3 rounded-xl bg-[#0b1120] border border-slate-800">
            <span class="block font-semibold text-white mb-1">5–6 Cycles (Ideal)</span>
            7.5 to 9.0 hours of sleep. Optimal for physical repair and cognitive clarity.
          </div>
          <div class="p-3 rounded-xl bg-[#0b1120] border border-slate-800">
            <span class="block font-semibold text-white mb-1">Sleep Inertia</span>
            Waking up in the middle of deep sleep causes grogginess and brain fog.
          </div>
          <div class="p-3 rounded-xl bg-[#0b1120] border border-slate-800">
            <span class="block font-semibold text-white mb-1">15-Min Buffer</span>
            Accounts for the average time it takes a relaxed person to fall asleep.
          </div>
        </div>
      </section>

    </div>

  </main>

  <!-- Footer -->
  <footer class="border-t border-slate-800/80 py-6 text-center text-xs text-zinc-500 font-mono">
    <p>Offline-ready • 100% Client-side • Small Tools Plus</p>
  </footer>

  <script is:inline>
    // Format Date to "11:25 AM"
    function formatTime(date) {
      let hours = date.getHours();
      const minutes = date.getMinutes();
      const ampm = hours >= 12 ? 'AM' : 'AM'; // fallback
      const realAmpm = hours >= 12 ? 'PM' : 'AM';
      hours = hours % 12;
      hours = hours ? hours : 12;
      const strMinutes = minutes < 10 ? '0' + minutes : minutes;
      return `${hours}:${strMinutes} ${realAmpm}`;
    }

    // Render the simple 2-column grid matching Image 2
    // Left column: 6 cycles, 4 cycles, 2 cycles
    // Right column: 5 cycles, 3 cycles, 1 cycle
    function renderSleepNow() {
      const now = new Date();
      const container = document.getElementById('sleepTimesGrid');
      if (!container) return;

      // Ordered pairs to match Image 2:
      // Row 1: 6 cycles, 5 cycles
      // Row 2: 4 cycles, 3 cycles
      // Row 3: 2 cycles, 1 cycle
      const cycleList = [6, 5, 4, 3, 2, 1];
      let html = '';

      cycleList.forEach((cycle) => {
        const wakeDate = new Date(now.getTime() + (cycle * 90 + 15) * 60000);
        const timeFormatted = formatTime(wakeDate);
        const isSuggested = cycle >= 5;
        const hoursOfSleep = (cycle * 1.5).toFixed(1);

        html += `
          <button 
            type="button" 
            onclick="selectSleepTime(${cycle}, '${timeFormatted}', ${hoursOfSleep}, ${isSuggested}, this)"
            class="sleep-btn p-4 sm:p-5 rounded-xl bg-[#131b2e] border ${isSuggested ? 'border-amber-400/40' : 'border-slate-800'} text-center cursor-pointer hover:bg-[#1a2544] hover:border-indigo-400/50 flex flex-col items-center justify-center"
          >
            <div class="text-xl sm:text-2xl font-bold tracking-tight text-white font-mono">
              ${timeFormatted}
            </div>
            ${isSuggested ? `
              <div class="text-[11px] font-semibold text-[#FFDD88] tracking-widest mt-1 uppercase">
                SUGGESTED
              </div>
            ` : `
              <div class="text-[11px] text-transparent tracking-widest mt-1 uppercase select-none">
                &nbsp;
              </div>
            `}
          </button>
        `;
      });

      container.innerHTML = html;
    }

    // Interactive details card when clicking a time button
    function selectSleepTime(cycle, time, hours, isSuggested, btnElement) {
      document.querySelectorAll('.sleep-btn').forEach(btn => btn.classList.remove('selected'));
      if (btnElement) {
        btnElement.classList.add('selected');
      }

      const box = document.getElementById('selectionDetailBox');
      const cyclesEl = document.getElementById('detailCycles');
      const hoursEl = document.getElementById('detailHours');
      const descEl = document.getElementById('detailDescription');

      if (!box || !cyclesEl || !hoursEl || !descEl) return;

      cyclesEl.textContent = `${cycle} Complete Cycles`;
      hoursEl.textContent = `${hours} Hours of Sleep`;

      if (cycle === 6) {
        descEl.textContent = `★ Recommended: Waking at ${time} provides 9.0 hours of sleep for peak mental and physical recovery.`;
      } else if (cycle === 5) {
        descEl.textContent = `★ Recommended: Waking at ${time} gives 7.5 hours of restorative sleep, perfect for most adults.`;
      } else if (cycle === 4) {
        descEl.textContent = `Waking at ${time} gives 6.0 hours of sleep. Decent rest if you're on a tight schedule.`;
      } else if (cycle === 3) {
        descEl.textContent = `Waking at ${time} gives 4.5 hours of sleep. A core sleep period to avoid sleep inertia.`;
      } else if (cycle === 2) {
        descEl.textContent = `Waking at ${time} gives 3.0 hours of sleep. Short sleep block; may leave you wanting more.`;
      } else {
        descEl.textContent = `Waking at ${time} gives a 1.5-hour power cycle. Great for an emergency reset nap.`;
      }

      box.classList.remove('hidden');
    }

    // Toggle More Data Section
    function toggleMoreData() {
      const section = document.getElementById('moreDataSection');
      const text = document.getElementById('moreDataText');
      const icon = document.getElementById('moreDataIcon');
      if (!section) return;

      const isHidden = section.classList.contains('hidden');
      if (isHidden) {
        section.classList.remove('hidden');
        if (text) text.textContent = 'Hide Extra Options & Data';
        if (icon) icon.textContent = '▴';
        calculateBedtimes();
        section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else {
        section.classList.add('hidden');
        if (text) text.textContent = 'Plan Custom Wake Time & More Data';
        if (icon) icon.textContent = '▾';
      }
    }

    // Plan Bedtimes Calculation
    function calculateBedtimes() {
      const input = document.getElementById('targetWakeTime');
      const container = document.getElementById('bedtimesGrid');
      if (!input || !container) return;

      const [hours, minutes] = input.value.split(':').map(Number);
      const targetDate = new Date();
      targetDate.setHours(hours, minutes, 0, 0);

      const cycleList = [6, 5, 4, 3, 2, 1];
      let html = '';

      cycleList.forEach((cycle) => {
        const bedDate = new Date(targetDate.getTime() - (cycle * 90 + 15) * 60000);
        const timeFormatted = formatTime(bedDate);
        const isSuggested = cycle >= 5;

        html += `
          <div class="p-3 sm:p-4 rounded-xl bg-[#0b1120] border ${isSuggested ? 'border-amber-400/40' : 'border-slate-800'} text-center">
            <div class="text-base sm:text-xl font-bold font-mono text-white">
              ${timeFormatted}
            </div>
            <div class="text-[10px] text-zinc-400 mt-0.5">
              ${cycle} Cycles (${(cycle * 1.5).toFixed(1)} hrs)
            </div>
            ${isSuggested ? `
              <span class="inline-block mt-1 text-[10px] font-semibold text-[#FFDD88] uppercase tracking-wider">
                ★ Suggested
              </span>
            ` : ''}
          </div>
        `;
      });

      container.innerHTML = html;
    }

    // Standalone PWA install handler
    let toolInstallPrompt = null;
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      toolInstallPrompt = e;
      const btn = document.getElementById('pwaInstallToolBtn');
      if (btn) btn.style.display = 'inline-flex';
    });

    function triggerToolPwaInstall() {
      if (toolInstallPrompt) {
        toolInstallPrompt.prompt();
        toolInstallPrompt.userChoice.then(() => {
          toolInstallPrompt = null;
          const btn = document.getElementById('pwaInstallToolBtn');
          if (btn) btn.style.display = 'none';
        });
      }
    }

    // Register Service Worker
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(err => {
          console.warn('[SW] Registration failed:', err);
        });
      });
    }

    // Initial render
    renderSleepNow();

    // Auto refresh times every 60 seconds
    setInterval(renderSleepNow, 60000);
  </script>
</body>
</html>
