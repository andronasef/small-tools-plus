  <!-- Floating Toast Notification -->
  <div id="toast" class="bg-zinc-900 border border-zinc-750 text-white text-xs px-4 py-2.5 rounded-xl shadow-2xl flex items-center gap-2.5">
    <span id="toastIcon">✓</span>
    <span id="toastMsg">Action completed</span>
    <button id="toastUndoBtn" onclick="handleUndoDelete()" class="hidden text-purple-400 hover:text-purple-300 font-bold ml-1.5 underline">Undo</button>
  </div>

  <!-- Client-side Logic Script -->
  <script is:inline>
    // Storage Key
    const STORAGE_KEY = 'stp_triage_board_state_v1';

    // State Model
    let boardState = {
      backlog: [],
      red: [],
      green: [],
      yellow: [],
      titles: {
        red: 'Urgent & High Focus',
        green: 'In Flow & Normal',
        yellow: 'Later & Low Priority'
      }
    };

    // Active drag tracking
    let draggedTaskId = null;
    let draggedFromZone = null;

    // Context menu active item
    let ctxActiveTaskId = null;
    let ctxActiveZone = null;

    // Deleted task backup for undo
    let lastDeletedTask = null;
    let lastDeletedZone = null;
    let toastTimeout = null;

    // Default starter tasks for first-time visitors
    const DEFAULT_DATA = {
      backlog: [
        { id: 't-1', text: 'Update dependencies to latest versions', createdAt: Date.now() - 50000 },
        { id: 't-2', text: 'Write changelog for v2 release', createdAt: Date.now() - 40000 },
        { id: 't-3', text: 'Refactor mobile navigation drawer', createdAt: Date.now() - 30000 }
      ],
      red: [
        { id: 't-4', text: 'Fix critical session timeout bug', createdAt: Date.now() - 20000 }
      ],
      green: [
        { id: 't-5', text: 'Implement visual task drag and drop', createdAt: Date.now() - 10000 }
      ],
      yellow: [
        { id: 't-6', text: 'Explore dark theme color variants', createdAt: Date.now() - 5000 }
      ],
      titles: {
        red: 'Urgent & High Focus',
        green: 'In Flow & Normal',
        yellow: 'Later & Low Priority'
      }
    };

    // Load state from localStorage
    function loadState() {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
          const parsed = JSON.parse(saved);
          boardState = {
            backlog: parsed.backlog || [],
            red: parsed.red || [],
            green: parsed.green || [],
            yellow: parsed.yellow || [],
            titles: {
              red: parsed.titles?.red || 'Urgent & High Focus',
              green: parsed.titles?.green || 'In Flow & Normal',
              yellow: parsed.titles?.yellow || 'Later & Low Priority'
            }
          };
        } else {
          boardState = JSON.parse(JSON.stringify(DEFAULT_DATA));
          saveState();
        }
      } catch (err) {
        console.warn('Failed to parse board state from localStorage:', err);
        boardState = JSON.parse(JSON.stringify(DEFAULT_DATA));
      }
    }

    // Save state to localStorage
    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(boardState));
      } catch (err) {
        console.warn('Failed to save to localStorage:', err);
      }
    }

    // Render all zones
    function renderBoard() {
      // Update zone titles
      document.getElementById('label-red').textContent = boardState.titles.red;
      document.getElementById('label-green').textContent = boardState.titles.green;
      document.getElementById('label-yellow').textContent = boardState.titles.yellow;

      // Render each zone
      renderZone('backlog');
      renderZone('red');
      renderZone('green');
      renderZone('yellow');

      // Update counters
      document.getElementById('backlogCount').textContent = boardState.backlog.length;
      document.getElementById('count-red').textContent = `${boardState.red.length} task${boardState.red.length === 1 ? '' : 's'}`;
      document.getElementById('count-green').textContent = `${boardState.green.length} task${boardState.green.length === 1 ? '' : 's'}`;
      document.getElementById('count-yellow').textContent = `${boardState.yellow.length} task${boardState.yellow.length === 1 ? '' : 's'}`;

      // Update mobile segmented counters
      const mobileBacklogCount = document.getElementById('mobileTabBacklogCount');
      if (mobileBacklogCount) mobileBacklogCount.textContent = boardState.backlog.length;

      const mobileZonesCount = document.getElementById('mobileTabZonesCount');
      if (mobileZonesCount) {
        const totalInZones = boardState.red.length + boardState.green.length + boardState.yellow.length;
        mobileZonesCount.textContent = totalInZones;
      }

      // Adjust dynamic flex growth based on items count
      adjustZoneFlex();
    }

    // Render individual zone
    function renderZone(zoneKey) {
      const container = document.getElementById(`zone-${zoneKey}`);
      if (!container) return;

      const tasks = boardState[zoneKey] || [];
      container.innerHTML = '';

      if (tasks.length === 0) {
        const emptyState = document.createElement('div');
        emptyState.className = 'w-full flex items-center justify-center p-2.5 rounded-lg border border-dashed border-zinc-800/80 text-zinc-500 text-xs text-center select-none min-h-[42px]';
        
        if (zoneKey === 'backlog') {
          emptyState.innerHTML = '<span>No backlog items. Type above to add!</span>';
        } else if (zoneKey === 'red') {
          emptyState.innerHTML = '<span class="text-rose-400/60">Drop urgent tasks here (🔴 Top)</span>';
        } else if (zoneKey === 'green') {
          emptyState.innerHTML = '<span class="text-emerald-400/60">Drop in-flow tasks here (🟢 Middle)</span>';
        } else if (zoneKey === 'yellow') {
          emptyState.innerHTML = '<span class="text-amber-400/60">Drop later tasks here (🟡 Bottom)</span>';
        }
        container.appendChild(emptyState);
        return;
      }

      tasks.forEach((task) => {
        const card = createTaskElement(task, zoneKey);
        container.appendChild(card);
      });
    }

    // Create task DOM element with event listeners
    function createTaskElement(task, zoneKey) {
      const card = document.createElement('div');
      card.className = 'task-card rounded-xl px-2.5 py-1.5 sm:px-3 sm:py-2 flex items-center gap-2 text-xs sm:text-sm group flex-shrink-0';
      card.setAttribute('draggable', 'true');
      card.setAttribute('data-id', task.id);
      card.setAttribute('data-zone', zoneKey);

      // Accent color indicator by zone
      let accentDot = '';
      if (zoneKey === 'red') accentDot = '<span class="w-1.5 h-1.5 rounded-full bg-rose-500 flex-shrink-0 shadow-sm shadow-rose-500/50"></span>';
      else if (zoneKey === 'green') accentDot = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-500 flex-shrink-0 shadow-sm shadow-emerald-500/50"></span>';
      else if (zoneKey === 'yellow') accentDot = '<span class="w-1.5 h-1.5 rounded-full bg-amber-500 flex-shrink-0 shadow-sm shadow-amber-500/50"></span>';
      else accentDot = '<span class="w-1.5 h-1.5 rounded-full bg-purple-400/80 flex-shrink-0 shadow-sm shadow-purple-500/30"></span>';

      card.innerHTML = `
        <span class="text-zinc-600 hover:text-zinc-400 cursor-grab flex-shrink-0 select-none text-xs leading-none" title="Drag to move">⠿</span>
        ${accentDot}
        <span class="task-text text-zinc-200 select-text leading-tight font-medium break-words max-w-[240px] sm:max-w-[340px]" dir="auto" title="Double click to edit">${escapeHtml(task.text)}</span>
        <button class="menu-btn p-1 rounded-md hover:bg-zinc-800 text-zinc-400 hover:text-white transition-opacity opacity-60 sm:opacity-0 group-hover:opacity-100 flex-shrink-0" title="Options">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"/>
          </svg>
        </button>
      `;

      // Drag event handlers
      card.addEventListener('dragstart', (e) => {
        draggedTaskId = task.id;
        draggedFromZone = zoneKey;
        card.classList.add('is-dragging');
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', task.id);
      });

      card.addEventListener('dragend', () => {
        card.classList.remove('is-dragging');
        clearDropHighlights();
      });

      // Double-click to inline edit (As requested)
      card.addEventListener('dblclick', (e) => {
        e.stopPropagation();
        startInlineTaskEdit(card, task, zoneKey);
      });

      // Right-click context menu (As requested)
      card.addEventListener('contextmenu', (e) => {
        e.preventDefault();
        e.stopPropagation();
        openContextMenu(e.clientX, e.clientY, task, zoneKey);
      });

      // Single menu button click (opens options menu)
      const menuBtn = card.querySelector('.menu-btn');
      if (menuBtn) {
        menuBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const rect = menuBtn.getBoundingClientRect();
          openContextMenu(rect.left, rect.bottom + 5, task, zoneKey);
        });
      }

      return card;
    }

    // Dynamic Zone Flex sizing
    // Each of the 3 right-side zones grows proportionally according to its task count
    function adjustZoneFlex() {
      const redCount = boardState.red.length;
      const greenCount = boardState.green.length;
      const yellowCount = boardState.yellow.length;

      const boxRed = document.getElementById('box-red');
      const boxGreen = document.getElementById('box-green');
      const boxYellow = document.getElementById('box-yellow');

      if (!boxRed || !boxGreen || !boxYellow) return;

      // Estimate row count (assuming ~3 chips per row in Pinterest wrap layout)
      const rowsRed = Math.max(1, Math.ceil(redCount / 3));
      const rowsGreen = Math.max(1, Math.ceil(greenCount / 3));
      const rowsYellow = Math.max(1, Math.ceil(yellowCount / 3));

      // Calculate dynamic flex weights: base 1 + row growth
      const flexRed = 1 + (rowsRed - 1) * 0.45;
      const flexGreen = 1 + (rowsGreen - 1) * 0.45;
      const flexYellow = 1 + (rowsYellow - 1) * 0.45;

      boxRed.style.flex = `${flexRed} 1 0%`;
      boxGreen.style.flex = `${flexGreen} 1 0%`;
      boxYellow.style.flex = `${flexYellow} 1 0%`;
    }

    // Attach drop handlers to zones
    function setupDropZones() {
      const zones = ['backlog', 'red', 'green', 'yellow'];

      zones.forEach((zoneKey) => {
        const zoneElem = document.getElementById(`zone-${zoneKey}`);
        if (!zoneElem) return;

        zoneElem.addEventListener('dragover', (e) => {
          e.preventDefault();
          e.dataTransfer.dropEffect = 'move';
          zoneElem.classList.add('drag-over');
        });

        zoneElem.addEventListener('dragleave', (e) => {
          // Check if relatedTarget is outside the zone
          if (!zoneElem.contains(e.relatedTarget)) {
            zoneElem.classList.remove('drag-over');
          }
        });

        zoneElem.addEventListener('drop', (e) => {
          e.preventDefault();
          zoneElem.classList.remove('drag-over');

          const taskId = e.dataTransfer.getData('text/plain') || draggedTaskId;
          if (!taskId || !draggedFromZone) return;

          const targetCard = e.target.closest('.task-card');
          const targetId = targetCard ? targetCard.getAttribute('data-id') : null;

          moveTask(taskId, draggedFromZone, zoneKey, targetId);
        });
      });
    }

    function clearDropHighlights() {
      document.querySelectorAll('.zone-box, .zone-backlog').forEach((el) => {
        el.classList.remove('drag-over');
      });
    }

    // Move task between zones or reorder
    function moveTask(taskId, fromZone, toZone, targetId = null) {
      const fromList = boardState[fromZone];
      const taskIndex = fromList.findIndex((t) => t.id === taskId);
      if (taskIndex === -1) return;

      const [task] = fromList.splice(taskIndex, 1);
      const toList = boardState[toZone];

      if (targetId && targetId !== taskId) {
        const targetIndex = toList.findIndex((t) => t.id === targetId);
        if (targetIndex !== -1) {
          toList.splice(targetIndex, 0, task);
        } else {
          toList.push(task);
        }
      } else {
        toList.push(task);
      }

      saveState();
      renderBoard();
      showToast(`Moved to ${formatZoneName(toZone)}`, '✓');
    }

    function formatZoneName(key) {
      if (key === 'red') return '🔴 Red';
      if (key === 'green') return '🟢 Green';
      if (key === 'yellow') return '🟡 Yellow';
      return '📋 Backlog';
    }

    // Add new task
    function handleAddTask(e) {
      e.preventDefault();
      const input = document.getElementById('taskInput');
      const text = input.value.trim();
      if (!text) return;

      const newTask = {
        id: 't-' + Date.now() + '-' + Math.random().toString(36).substr(2, 4),
        text: text,
        createdAt: Date.now()
      };

      boardState.backlog.unshift(newTask);
      saveState();
      renderBoard();

      input.value = '';
      input.focus();
      showToast('Task added to backlog', '✓');
    }

    // Delete task with Undo option
    function deleteTask(taskId, zoneKey) {
      const list = boardState[zoneKey];
      const index = list.findIndex((t) => t.id === taskId);
      if (index === -1) return;

      lastDeletedTask = list[index];
      lastDeletedZone = zoneKey;

      list.splice(index, 1);
      saveState();
      renderBoard();

      showToast('Task deleted', '🗑️', true);
    }

    // Undo delete
    function handleUndoDelete() {
      if (!lastDeletedTask || !lastDeletedZone) return;
      boardState[lastDeletedZone].push(lastDeletedTask);
      saveState();
      renderBoard();

      lastDeletedTask = null;
      lastDeletedZone = null;
      showToast('Task restored', '↩');
    }

    // Inline edit task text (Triggered by double click or edit button)
    function startInlineTaskEdit(card, task, zoneKey) {
      const textContainer = card.querySelector('.task-text');
      if (!textContainer) return;

      const currentText = task.text;
      const input = document.createElement('input');
      input.type = 'text';
      input.value = currentText;
      input.setAttribute('dir', 'auto');
      input.className = 'inline-edit-input w-full py-1 px-2 rounded-lg bg-[#0d0d14] border border-purple-500 text-white text-xs sm:text-sm focus:outline-none';

      textContainer.replaceWith(input);
      input.focus();
      input.select();

      let finished = false;
      const finishEdit = (save) => {
        if (finished) return;
        finished = true;

        if (save) {
          const val = input.value.trim();
          if (val && val !== currentText) {
            task.text = val;
            saveState();
            showToast('Task updated', '✓');
          }
        }
        renderBoard();
      };

      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') finishEdit(true);
        if (e.key === 'Escape') finishEdit(false);
      });

      input.addEventListener('blur', () => {
        finishEdit(true);
      });
    }

    // Inline edit zone title
    function inlineEditZoneTitle(zoneKey) {
      const label = document.getElementById(`label-${zoneKey}`);
      if (!label) return;

      const current = boardState.titles[zoneKey];
      const input = document.createElement('input');
      input.type = 'text';
      input.value = current;
      input.setAttribute('dir', 'auto');
      input.className = 'inline-edit-input py-0.5 px-2 rounded bg-zinc-900 border border-purple-500 text-white text-xs font-bold focus:outline-none';

      label.replaceWith(input);
      input.focus();
      input.select();

      const commit = () => {
        const val = input.value.trim();
        if (val) {
          boardState.titles[zoneKey] = val;
          saveState();
        }
        renderBoard();
      };

      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') commit();
        if (e.key === 'Escape') renderBoard();
      });
      input.addEventListener('blur', commit);
    }

    // Right-Click Context Menu Logic
    function openContextMenu(x, y, task, zoneKey) {
      ctxActiveTaskId = task.id;
      ctxActiveZone = zoneKey;

      const menu = document.getElementById('contextMenu');
      const backdrop = document.getElementById('contextMenuBackdrop');
      const preview = document.getElementById('ctxTaskPreview');
      preview.textContent = `"${task.text.substring(0, 26)}${task.text.length > 26 ? '…' : ''}"`;

      menu.style.display = 'block';

      if (window.innerWidth <= 640) {
        // Mobile bottom sheet mode
        if (backdrop) backdrop.classList.remove('hidden');
        menu.style.left = '0px';
        menu.style.top = 'auto';
        menu.style.bottom = '0px';
      } else {
        // Desktop floating mode
        if (backdrop) backdrop.classList.add('hidden');
        const menuWidth = 210;
        const menuHeight = 220;

        let posX = x;
        let posY = y;
        if (posX + menuWidth > window.innerWidth) posX = window.innerWidth - menuWidth - 10;
        if (posY + menuHeight > window.innerHeight) posY = window.innerHeight - menuHeight - 10;

        menu.style.left = `${Math.max(10, posX)}px`;
        menu.style.top = `${Math.max(10, posY)}px`;
        menu.style.bottom = 'auto';
      }
    }

    function closeContextMenu() {
      const menu = document.getElementById('contextMenu');
      if (menu) menu.style.display = 'none';
      const backdrop = document.getElementById('contextMenuBackdrop');
      if (backdrop) backdrop.classList.add('hidden');
      ctxActiveTaskId = null;
      ctxActiveZone = null;
    }

    window.addEventListener('click', (e) => {
      if (!e.target.closest('#contextMenu') && !e.target.closest('.menu-btn')) {
        closeContextMenu();
      }
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeContextMenu();
        closeBulkAddModal();
        closePasteMarkdownModal();
      }
    });

    function handleCtxEdit() {
      if (!ctxActiveTaskId || !ctxActiveZone) return;
      const card = document.querySelector(`[data-id="${ctxActiveTaskId}"]`);
      const task = boardState[ctxActiveZone].find((t) => t.id === ctxActiveTaskId);
      closeContextMenu();
      if (card && task) {
        startInlineTaskEdit(card, task, ctxActiveZone);
      }
    }

    function handleCtxMove(targetZone) {
      if (!ctxActiveTaskId || !ctxActiveZone) return;
      const id = ctxActiveTaskId;
      const from = ctxActiveZone;
      closeContextMenu();
      if (from !== targetZone) {
        moveTask(id, from, targetZone);
      }
    }

    function handleCtxDelete() {
      if (!ctxActiveTaskId || !ctxActiveZone) return;
      const id = ctxActiveTaskId;
      const from = ctxActiveZone;
      closeContextMenu();
      deleteTask(id, from);
    }

    // Bulk Add Modal
    function openBulkAddModal() {
      const modal = document.getElementById('bulkModal');
      const input = document.getElementById('bulkInput');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      input.value = '';
      input.focus();
    }

    function closeBulkAddModal() {
      const modal = document.getElementById('bulkModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function handleBulkAddSubmit() {
      const input = document.getElementById('bulkInput');
      const lines = input.value.split('\n').map((l) => l.trim()).filter(Boolean);
      if (lines.length === 0) {
        closeBulkAddModal();
        return;
      }

      lines.reverse().forEach((line) => {
        boardState.backlog.unshift({
          id: 't-' + Date.now() + '-' + Math.random().toString(36).substr(2, 4),
          text: line,
          createdAt: Date.now()
        });
      });

      saveState();
      renderBoard();
      closeBulkAddModal();
      showToast(`Added ${lines.length} tasks to backlog`, '✓');
    }

    // Paste Markdown Modal Logic
    function openPasteMarkdownModal() {
      const modal = document.getElementById('pasteMarkdownModal');
      const textarea = document.getElementById('pasteMarkdownTextarea');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      textarea.value = '';
      textarea.focus();
    }

    function closePasteMarkdownModal() {
      const modal = document.getElementById('pasteMarkdownModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    async function handleClipboardPasteClick() {
      try {
        const text = await navigator.clipboard.readText();
        if (text) {
          document.getElementById('pasteMarkdownTextarea').value = text;
          showToast('Pasted from clipboard!', '📋');
        } else {
          showToast('Clipboard is empty', 'ℹ️');
        }
      } catch (err) {
        showToast('Please paste directly using Ctrl+V / Cmd+V', 'ℹ️');
      }
    }

    function handlePasteMarkdownSubmit() {
      const textarea = document.getElementById('pasteMarkdownTextarea');
      const text = textarea.value.trim();
      if (!text) {
        closePasteMarkdownModal();
        return;
      }

      const modeRadio = document.querySelector('input[name="importMode"]:checked');
      const mode = modeRadio ? modeRadio.value : 'merge';

      importMarkdownText(text, mode);
      closePasteMarkdownModal();
    }

    // Robust Markdown Parser & Importer
    function importMarkdownText(markdownText, mode = 'merge') {
      const lines = markdownText.split('\n');
      let currentZone = 'backlog';
      const imported = {
        backlog: [],
        red: [],
        green: [],
        yellow: []
      };

      for (let rawLine of lines) {
        const line = rawLine.trim();
        if (!line) continue;

        const lower = line.toLowerCase();
        // Section detection
        if (line.includes('🔴') || (line.startsWith('#') && (lower.includes('urgent') || lower.includes('high') || lower.includes('red')))) {
          currentZone = 'red';
          continue;
        } else if (line.includes('🟢') || (line.startsWith('#') && (lower.includes('flow') || lower.includes('normal') || lower.includes('green')))) {
          currentZone = 'green';
          continue;
        } else if (line.includes('🟡') || (line.startsWith('#') && (lower.includes('later') || lower.includes('low') || lower.includes('yellow')))) {
          currentZone = 'yellow';
          continue;
        } else if (line.includes('📋') || (line.startsWith('#') && lower.includes('backlog'))) {
          currentZone = 'backlog';
          continue;
        }

        // Skip headers or placeholder tokens
        if (line.startsWith('#') || line === '*(None)*' || line.startsWith('---')) {
          continue;
        }

        // Clean checklist / bullet prefixes
        let cleanText = line
          .replace(/^[-*+]\s*(\[[ xX]\])?\s*/, '')
          .replace(/^\d+[\.)]\s*/, '')
          .trim();

        if (cleanText) {
          imported[currentZone].push({
            id: 't-' + Date.now() + '-' + Math.random().toString(36).substr(2, 5),
            text: cleanText,
            createdAt: Date.now()
          });
        }
      }

      const total = imported.backlog.length + imported.red.length + imported.green.length + imported.yellow.length;
      if (total === 0) {
        showToast('No tasks found in pasted markdown', '⚠️');
        return;
      }

      if (mode === 'replace') {
        boardState.backlog = imported.backlog;
        boardState.red = imported.red;
        boardState.green = imported.green;
        boardState.yellow = imported.yellow;
      } else {
        boardState.backlog = [...imported.backlog, ...boardState.backlog];
        boardState.red = [...imported.red, ...boardState.red];
        boardState.green = [...imported.green, ...boardState.green];
        boardState.yellow = [...imported.yellow, ...boardState.yellow];
      }

      saveState();
      renderBoard();
      showToast(`Imported ${total} tasks from Markdown!`, '✓');
    }

    // Mobile Segmented View Tab Switcher
    let currentMobileTab = 'backlog';

    function switchMobileTab(tab) {
      currentMobileTab = tab;
      const colBacklog = document.getElementById('colBacklog');
      const colZones = document.getElementById('colZones');
      const btnBacklog = document.getElementById('mobileTabBacklog');
      const btnZones = document.getElementById('mobileTabZones');

      if (!colBacklog || !colZones) return;

      if (tab === 'backlog') {
        colBacklog.classList.remove('hidden');
        colZones.classList.add('hidden');
        colZones.classList.remove('flex');

        if (btnBacklog) btnBacklog.className = 'flex-1 py-2 text-xs font-semibold rounded-lg transition flex items-center justify-center gap-1.5 bg-purple-600 text-white shadow-sm';
        if (btnZones) btnZones.className = 'flex-1 py-2 text-xs font-semibold rounded-lg transition flex items-center justify-center gap-1.5 text-zinc-400 hover:text-white';
      } else {
        colBacklog.classList.add('hidden');
        colZones.classList.remove('hidden');
        colZones.classList.add('flex');

        if (btnBacklog) btnBacklog.className = 'flex-1 py-2 text-xs font-semibold rounded-lg transition flex items-center justify-center gap-1.5 text-zinc-400 hover:text-white';
        if (btnZones) btnZones.className = 'flex-1 py-2 text-xs font-semibold rounded-lg transition flex items-center justify-center gap-1.5 bg-purple-600 text-white shadow-sm';
      }
    }

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024) {
        const colBacklog = document.getElementById('colBacklog');
        const colZones = document.getElementById('colZones');
        if (colBacklog) colBacklog.classList.remove('hidden');
        if (colZones) {
          colZones.classList.remove('hidden');
          colZones.classList.add('flex');
        }
      } else {
        switchMobileTab(currentMobileTab);
      }
    });

    // Copy entire board as formatted Markdown
    function copyBoardAsMarkdown() {
      let md = `# Task Triage Flow\n\n`;

      md += `### 🔴 ${boardState.titles.red} (${boardState.red.length})\n`;
      if (boardState.red.length === 0) md += `*(None)*\n`;
      else boardState.red.forEach((t) => { md += `- [ ] ${t.text}\n`; });
      md += `\n`;

      md += `### 🟢 ${boardState.titles.green} (${boardState.green.length})\n`;
      if (boardState.green.length === 0) md += `*(None)*\n`;
      else boardState.green.forEach((t) => { md += `- [ ] ${t.text}\n`; });
      md += `\n`;

      md += `### 🟡 ${boardState.titles.yellow} (${boardState.yellow.length})\n`;
      if (boardState.yellow.length === 0) md += `*(None)*\n`;
      else boardState.yellow.forEach((t) => { md += `- [ ] ${t.text}\n`; });
      md += `\n`;

      md += `### 📋 Backlog (${boardState.backlog.length})\n`;
      if (boardState.backlog.length === 0) md += `*(None)*\n`;
      else boardState.backlog.forEach((t) => { md += `- [ ] ${t.text}\n`; });

      navigator.clipboard.writeText(md).then(() => {
        showToast('Board copied as Markdown!', '📋');
      }).catch(() => {
        showToast('Failed to copy to clipboard', '⚠️');
      });
    }

    // Confirm clear board
    function confirmClearBoard() {
      if (confirm('Are you sure you want to clear all tasks from the entire board?')) {
        boardState.backlog = [];
        boardState.red = [];
        boardState.green = [];
        boardState.yellow = [];
        saveState();
        renderBoard();
        showToast('Board cleared', '🧹');
      }
    }

    // Toast Notifications
    function showToast(message, icon = '✓', showUndo = false) {
      const toast = document.getElementById('toast');
      const msg = document.getElementById('toastMsg');
      const icn = document.getElementById('toastIcon');
      const undo = document.getElementById('toastUndoBtn');

      if (!toast) return;

      msg.textContent = message;
      icn.textContent = icon;
      if (showUndo) undo.classList.remove('hidden');
      else undo.classList.add('hidden');

      toast.classList.add('show');

      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.classList.remove('show');
      }, 4000);
    }

    // Escape HTML helper
    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    // Standalone PWA install handler
    let toolInstallPrompt = null;
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      toolInstallPrompt = e;
      const btn = document.getElementById('pwaInstallToolBtn');
      if (btn) btn.style.display = 'inline-flex';
    });

    function triggerToolPwaInstall() {
      if (toolInstallPrompt) {
        toolInstallPrompt.prompt();
        toolInstallPrompt.userChoice.then(() => {
          toolInstallPrompt = null;
          const btn = document.getElementById('pwaInstallToolBtn');
          if (btn) btn.style.display = 'none';
        });
      }
    }

    // Service Worker Registration
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch((err) => {
          console.warn('[SW] Registration failed:', err);
        });
      });
    }

    // Initialize
    loadState();
    renderBoard();
    setupDropZones();
  </script>
</body>
</html>
