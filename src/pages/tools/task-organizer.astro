  <div id="bulkModal" class="fixed inset-0 z-50 bg-black/75 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-[#14141e] border border-zinc-700 rounded-2xl max-w-md w-full p-5 shadow-2xl animate-in">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-sm font-bold text-white flex items-center gap-2">
          <span>📋 Bulk Paste Mini-Tasks</span>
