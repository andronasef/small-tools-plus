---
import { tools, categories } from '../data/tools';
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Small Tools Plus — Local Utility Directory</title>
  <meta name="description" content="A curated directory of standalone personal web utilities. Offline-first, client-side only.">
  <link rel="icon" type="image/svg+xml" href="icons/icon.svg">

  <!-- Canonical & Social Metadata -->
  <link rel="canonical" href="https://small.andronasef.com/">
  <meta property="og:title" content="Small Tools Plus — Local Utility Directory">
  <meta property="og:description" content="A curated directory of standalone personal web utilities. Offline-first, installable PWA.">
  <meta property="og:url" content="https://small.andronasef.com/">
  <meta property="og:type" content="website">
  <meta property="og:image" content="https://small.andronasef.com/icons/icon-512.png">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="Small Tools Plus">
  <meta name="twitter:description" content="A curated directory of standalone personal web utilities. Offline-first, installable PWA.">
  <meta name="twitter:image" content="https://small.andronasef.com/icons/icon-512.png">

  <!-- PWA & Mobile Web App Meta -->
  <link rel="manifest" href="manifest.webmanifest">
  <meta name="theme-color" content="#101014">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="SmallTools+">
  <link rel="apple-touch-icon" href="icons/icon-192.png">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <!-- Tailwind CSS (Offline-first compiled bundle) -->
  <link rel="stylesheet" href="tailwind.css">

  <!-- Unified Theme Stylesheet -->
  <link rel="stylesheet" href="style.css">

  <style>
    body {
      font-size: 15px;
      line-height: 1.6;
    }
    h1 {
      font-size: 28px;
      line-height: 1.25;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    h2 {
      font-size: 19px;
      line-height: 1.35;
      font-weight: 600;
      letter-spacing: -0.01em;
    }
    h3 {
      font-size: 15px;
      line-height: 1.4;
      font-weight: 600;
    }

    ::selection {
      background: #3b82f6;
      color: #ffffff;
    }
    .dark ::selection {
      background: #2563eb;
      color: #ffffff;
    }

    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 3px;
    }
    .dark ::-webkit-scrollbar-thumb {
      background: #334155;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
    .dark ::-webkit-scrollbar-thumb:hover {
      background: #475569;
    }

    a:focus-visible, button:focus-visible, input:focus-visible {
      outline: 2px solid #3b82f6;
      outline-offset: 2px;
    }
  </style>
</head>
<body class="bg-slate-50 dark:bg-zinc-950 text-slate-900 dark:text-zinc-100 min-h-screen flex flex-col font-sans antialiased">

  <!-- Top Navigation Bar -->
  <header class="border-b border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-925 sticky top-0 z-30">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-4">
      
      <!-- Brand -->
      <div class="flex items-center gap-3">
        <a href="./" class="flex items-center gap-2 text-inherit no-underline">
          <img src="icons/icon.svg" width="24" height="24" class="w-6 h-6 rounded-md shadow-sm" alt="Logo" />
          <span class="font-mono text-xs font-semibold text-slate-900 dark:text-zinc-100 px-2 py-0.5 rounded bg-slate-100 dark:bg-zinc-850 border border-slate-200 dark:border-zinc-700">
            stp://
          </span>
          <span class="font-semibold text-sm tracking-tight text-slate-900 dark:text-zinc-100 hidden sm:inline">Small Tools Plus</span>
        </a>
        <span class="text-xs text-slate-500 dark:text-zinc-400 font-mono">({tools.length} tools)</span>
      </div>

      <!-- Header Action Controls -->
      <div class="flex items-center gap-2.5 sm:gap-3">
        <!-- Live Filter Field -->
        <div class="relative w-36 sm:w-60">
          <input 
            type="text" 
            id="searchInput" 
            placeholder="Filter tools (/)" 
            class="w-full pl-8 pr-7 py-1.5 text-xs bg-slate-100 dark:bg-zinc-850 text-slate-900 dark:text-zinc-100 placeholder-slate-400 dark:placeholder-zinc-500 border border-slate-200 dark:border-zinc-700 rounded-md focus:border-blue-500 focus:outline-none transition"
            autocomplete="off"
            spellcheck="false"
          >
          <svg class="w-3.5 h-3.5 text-slate-400 dark:text-zinc-500 absolute left-2.5 top-2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <button id="clearSearchBtn" onclick="clearSearch()" class="hidden absolute right-2 top-1.5 text-slate-400 hover:text-slate-700 dark:hover:text-zinc-200 text-xs px-1">
            ✕
          </button>
        </div>

        <!-- Offline Storage / Asset Downloader Button -->
        <button 
          id="offlineBtn" 
          onclick="toggleOfflineModal()" 
          title="Offline Assets & PWA Storage"
          class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-md text-xs font-mono bg-slate-100 hover:bg-slate-200 dark:bg-zinc-850 dark:hover:bg-zinc-800 text-slate-700 dark:text-zinc-300 border border-slate-200 dark:border-zinc-700 transition"
        >
          <span id="offlineStatusDot" class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span id="offlineStatusText" class="hidden md:inline">Offline</span>
        </button>

        <!-- PWA Install Button -->
        <button 
          id="pwaInstallBtn" 
          onclick="triggerPwaInstall()" 
          title="Install Small Tools Plus (PWA)"
          class="hidden items-center gap-1.5 px-2.5 py-1.5 rounded-md text-xs font-medium bg-blue-600 hover:bg-blue-700 text-white shadow-sm transition"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          <span class="hidden sm:inline">Install</span>
        </button>

        <!-- Theme Toggle -->
        <button 
          id="themeToggleBtn" 
          onclick="toggleTheme()" 
          title="Toggle theme (D)"
          class="p-1.5 rounded-md text-slate-500 hover:text-slate-900 dark:text-zinc-400 dark:hover:text-zinc-100 hover:bg-slate-100 dark:hover:bg-zinc-850 border border-transparent hover:border-slate-200 dark:hover:border-zinc-700 transition"
        >
          <svg id="themeIconSun" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg id="themeIconMoon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>
      </div>

    </div>
  </header>

  <!-- Main Container -->
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-10 flex-1 w-full">
    
    <!-- Directory Header Block -->
    <div class="pb-6 border-b border-slate-200 dark:border-zinc-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <h1 class="text-slate-900 dark:text-zinc-100">
        Tools
      </h1>

      <!-- Category Filter Buttons (Dynamic) -->
      <div class="flex flex-wrap items-center gap-1.5 text-xs font-medium">
        {categories.map((cat, idx) => (
          <button 
            onclick={`setCategory('${cat.id}')`}
            data-category={cat.id}
            class={`cat-filter px-3 py-1.5 rounded-md transition ${idx === 0 ? 'active-filter bg-slate-900 text-white dark:bg-zinc-100 dark:text-zinc-900' : 'text-slate-600 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-zinc-100 hover:bg-slate-100 dark:hover:bg-zinc-850'}`}
          >
            {cat.label} ({cat.count})
          </button>
        ))}
      </div>
    </div>

    <!-- Clickable Cards Grid (Dynamic) -->
    <div id="toolsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mt-6">
      {tools.map((tool, idx) => (
        <div 
          data-tool-id={tool.id} 
          data-category={tool.category.toLowerCase()}
          data-mobile={tool.mobile ? 'true' : 'false'}
          data-keywords={tool.keywords}
          class="tool-card group relative p-5 rounded-lg border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-925 hover:border-blue-500/50 dark:hover:border-blue-400/50 transition flex flex-col justify-between cursor-pointer"
        >
          <div>
            <div class="flex items-center justify-between text-xs text-slate-400 dark:text-zinc-500 font-mono mb-4">
              <span class="font-mono text-xs px-1.5 py-0.5 rounded bg-slate-100 dark:bg-zinc-850 border border-slate-200 dark:border-zinc-800">
                {tool.number}
              </span>
              {tool.mobile && (
                <span title="Mobile PWA Ready" class="text-sm select-none">
                  📱
                </span>
              )}
            </div>

            <div class="flex items-start gap-3.5">
              <div 
                class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition"
                style={`background-color: ${tool.accentColor}18; border: 1px solid ${tool.accentColor}33; color: ${tool.accentColor};`}
              >
                <img src={`icons/${tool.iconFile}`} width="20" height="20" class="w-5 h-5" alt="" />
              </div>
              <div>
                <h2 class="text-slate-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                  <a href={tool.file} class="after:absolute after:inset-0 focus:outline-none">
                    {tool.title}
                  </a>
                </h2>
                <div class="mt-1 text-xs text-slate-500 dark:text-zinc-400 font-mono">
                  <span>{tool.category}</span>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-5 pt-3 border-t border-slate-100 dark:border-zinc-850 flex items-center justify-end relative z-10">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-medium bg-slate-900 text-white dark:bg-zinc-100 dark:text-zinc-900 group-hover:bg-blue-600 dark:group-hover:bg-blue-500 dark:group-hover:text-white transition">
              <span>Open</span>
              <kbd class="font-mono text-[10px] opacity-70">{idx + 1}</kbd>
            </span>
          </div>
        </div>
      ))}
    </div>

    <!-- Empty Filter State -->
    <div id="noResultsState" class="hidden text-center py-16 px-4">
      <p class="font-medium text-slate-800 dark:text-zinc-200">No matching tools found</p>
      <p class="text-xs text-slate-500 dark:text-zinc-400 mt-1">
        Try typing "calendar", "wheel", or "notion".
      </p>
      <button type="button" onclick="clearSearch()" class="mt-4 px-3 py-1.5 rounded text-xs font-medium bg-slate-200 dark:bg-zinc-850 text-slate-800 dark:text-zinc-200 hover:bg-slate-300 dark:hover:bg-zinc-700 transition">
        Reset filter
      </button>
    </div>

  </main>

  <!-- Offline Storage & Asset Manager Modal -->
  <div id="offlineModal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 rounded-2xl max-w-lg w-full p-6 shadow-2xl relative text-slate-900 dark:text-zinc-100">
      
      <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-zinc-800">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center text-sm font-mono">
            ↓
          </div>
          <div>
            <h3 class="font-semibold text-sm">Offline Storage & Assets</h3>
            <p class="text-xs text-slate-500 dark:text-zinc-400 font-mono">PWA Cache Management</p>
          </div>
        </div>
        <button onclick="toggleOfflineModal()" class="text-slate-400 hover:text-slate-700 dark:hover:text-zinc-200 p-1 rounded-md hover:bg-slate-100 dark:hover:bg-zinc-850 transition">
          ✕
        </button>
      </div>

      <div class="mt-4 space-y-4">
        <p class="text-xs text-slate-600 dark:text-zinc-300 leading-relaxed">
          جميع الأدوات والملفات (الصفحات، الفيديوهات، الصور، الخطوط، وملفات الـ CDN) يتم تنزيلها وتخزينها في المتصفح لتعمل <strong>أوفلاين بنسبة 100%</strong> بدون أي اتصال بالإنترنت.
        </p>

        <!-- Status Summary Cards -->
        <div class="grid grid-cols-2 gap-2 text-xs font-mono">
          <div class="p-3 rounded-lg bg-slate-50 dark:bg-zinc-850 border border-slate-200/80 dark:border-zinc-800">
            <span class="text-slate-400 dark:text-zinc-500 block text-[10px] uppercase">Tools Available</span>
            <span class="font-semibold text-slate-800 dark:text-zinc-200 text-sm">{tools.length} / {tools.length} Tools</span>
          </div>
          <div class="p-3 rounded-lg bg-slate-50 dark:bg-zinc-850 border border-slate-200/80 dark:border-zinc-800">
            <span class="text-slate-400 dark:text-zinc-500 block text-[10px] uppercase">Media & Videos</span>
            <span class="font-semibold text-slate-800 dark:text-zinc-200 text-sm">10 Files (MP4/GIF)</span>
          </div>
        </div>

        <!-- Download Progress Bar -->
        <div id="downloadProgressContainer" class="hidden space-y-2 pt-2">
          <div class="flex justify-between items-center text-xs font-mono">
            <span id="downloadStatusText" class="text-slate-600 dark:text-zinc-300 truncate max-w-[280px]">جاري التحضير...</span>
            <span id="downloadPercentText" class="font-bold text-blue-600 dark:text-blue-400">0%</span>
          </div>
          <div class="w-full h-2.5 bg-slate-100 dark:bg-zinc-800 rounded-full overflow-hidden">
            <div id="downloadProgressBar" class="h-full bg-blue-600 dark:bg-blue-500 rounded-full transition-all duration-200 w-0"></div>
          </div>
        </div>

        <!-- Feedback Alert Box -->
        <div id="offlineSuccessAlert" class="hidden p-3 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-xs">
          ✓ تم تنزيل وحفظ كافة الأدوات، الفيديوهات، الخطوط والملفات بنجاح! التطبيق جاهز تماماً للاستخدام بدون إنترنت.
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center gap-3 pt-2">
          <button 
            id="downloadAllAssetsBtn" 
            onclick="downloadAllOfflineAssets()" 
            class="flex-1 py-2.5 px-4 rounded-lg bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-medium text-xs shadow transition flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
            <span>تنزيل كافة الأدوات والملفات للأوفلاين (Download All)</span>
          </button>
          <button 
            type="button"
            onclick="clearOfflineCache()" 
            title="حذف الكاش وتحديثه"
            class="py-2.5 px-3 rounded-lg border border-slate-200 dark:border-zinc-700 text-slate-600 dark:text-zinc-400 hover:text-red-600 dark:hover:text-red-400 hover:bg-slate-100 dark:hover:bg-zinc-850 text-xs transition font-mono"
          >
            Clear
          </button>
        </div>

      </div>

    </div>
  </div>

  <!-- Footer with Keyboard Reference (Dynamic) -->
  <footer class="border-t border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-925 py-6 mt-auto">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-zinc-400 font-mono">
      <div class="flex items-center gap-2">
        <a href="https://small.andronasef.com" class="hover:text-blue-500 dark:hover:text-blue-400 transition-colors font-medium">small.andronasef.com</a>
        <span>•</span>
        <span>Zero-backend Offline PWA</span>
      </div>

      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        {tools.map((tool, idx) => (
          <span><kbd class="text-slate-700 dark:text-zinc-300">{idx + 1}</kbd> {tool.shortTitle}</span>
        ))}
        <span><kbd class="text-slate-700 dark:text-zinc-300">/</kbd> Filter</span>
        <span><kbd class="text-slate-700 dark:text-zinc-300">D</kbd> Theme</span>
        <span><kbd class="text-slate-700 dark:text-zinc-300">Esc</kbd> Clear</span>
      </div>
    </div>
  </footer>

  <!-- Scripts -->
  <script is:inline>
    // Theme Management
    const themeToggleBtn = document.getElementById('themeToggleBtn');
    const themeIconSun = document.getElementById('themeIconSun');
    const themeIconMoon = document.getElementById('themeIconMoon');

    function initTheme() {
      const saved = localStorage.getItem('stp_theme');
      if (saved === 'light') {
        document.documentElement.classList.remove('dark');
        themeIconSun?.classList.remove('hidden');
        themeIconMoon?.classList.add('hidden');
      } else {
        document.documentElement.classList.add('dark');
        themeIconSun?.classList.add('hidden');
        themeIconMoon?.classList.remove('hidden');
      }
    }

    function toggleTheme() {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('stp_theme', 'light');
        themeIconSun?.classList.remove('hidden');
        themeIconMoon?.classList.add('hidden');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('stp_theme', 'dark');
        themeIconSun?.classList.add('hidden');
        themeIconMoon?.classList.remove('hidden');
      }
    }

    // Filter Logic
    const searchInput = document.getElementById('searchInput');
    const clearSearchBtn = document.getElementById('clearSearchBtn');
    const toolsGrid = document.getElementById('toolsGrid');
    const noResultsState = document.getElementById('noResultsState');
    let currentCategory = 'all';

    function filterTools() {
      const query = (searchInput.value || '').trim().toLowerCase();
      
      if (query.length > 0) {
        clearSearchBtn.classList.remove('hidden');
      } else {
        clearSearchBtn.classList.add('hidden');
      }

      const items = toolsGrid.querySelectorAll('.tool-card');
      let visible = 0;

      items.forEach(item => {
        const itemCat = item.getAttribute('data-category') || '';
        const isMobile = item.getAttribute('data-mobile') === 'true';
        const keywords = (item.getAttribute('data-keywords') || '').toLowerCase();
        const text = item.innerText.toLowerCase();

        let catMatches = false;
        if (currentCategory === 'all') {
          catMatches = true;
        } else if (currentCategory === 'mobile') {
          catMatches = isMobile;
        } else {
          catMatches = itemCat === currentCategory;
        }

        const queryMatches = query === '' || keywords.includes(query) || text.includes(query);

        if (catMatches && queryMatches) {
          item.classList.remove('hidden');
          visible++;
        } else {
          item.classList.add('hidden');
        }
      });

      if (visible === 0) {
        noResultsState.classList.remove('hidden');
      } else {
        noResultsState.classList.add('hidden');
      }
    }

    function setCategory(cat) {
      currentCategory = cat;
      document.querySelectorAll('.cat-filter').forEach(btn => {
        if (btn.getAttribute('data-category') === cat) {
          btn.className = 'cat-filter active-filter px-3 py-1.5 rounded-md bg-slate-900 text-white dark:bg-zinc-100 dark:text-zinc-900 transition';
        } else {
          btn.className = 'cat-filter px-3 py-1.5 rounded-md text-slate-600 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-zinc-100 hover:bg-slate-100 dark:hover:bg-zinc-850 transition';
        }
      });
      filterTools();
    }

    function clearSearch() {
      searchInput.value = '';
      clearSearchBtn.classList.add('hidden');
      currentCategory = 'all';
      setCategory('all');
      filterTools();
      searchInput.focus();
    }

    searchInput?.addEventListener('input', filterTools);

    // Keyboard Shortcuts
    const toolUrls = Array.from(document.querySelectorAll('.tool-card a')).map(a => a.getAttribute('href'));

    window.addEventListener('keydown', (e) => {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') {
        if (e.key === 'Escape') {
          e.target.blur();
          clearSearch();
        }
        return;
      }

      if (e.key === 'Escape') {
        if (searchInput.value) {
          clearSearch();
        }
      } else if (e.key === '/' || (e.ctrlKey && e.key === 'k') || (e.metaKey && e.key === 'k')) {
        e.preventDefault();
        searchInput.focus();
        searchInput.select();
      } else if (e.key >= '1' && e.key <= '9') {
        const num = parseInt(e.key, 10);
        if (num <= toolUrls.length) {
          window.location.href = toolUrls[num - 1];
        }
      } else if (e.key === 'd' || e.key === 'D') {
        toggleTheme();
      }
    });

    // PWA & Offline Asset Management
    let deferredPrompt = null;
    const pwaInstallBtn = document.getElementById('pwaInstallBtn');
    const offlineModal = document.getElementById('offlineModal');
    const offlineStatusDot = document.getElementById('offlineStatusDot');
    const offlineStatusText = document.getElementById('offlineStatusText');
    const downloadProgressContainer = document.getElementById('downloadProgressContainer');
    const downloadProgressBar = document.getElementById('downloadProgressBar');
    const downloadStatusText = document.getElementById('downloadStatusText');
    const downloadPercentText = document.getElementById('downloadPercentText');
    const offlineSuccessAlert = document.getElementById('offlineSuccessAlert');
    const downloadAllAssetsBtn = document.getElementById('downloadAllAssetsBtn');

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
      if (pwaInstallBtn) {
        pwaInstallBtn.classList.remove('hidden');
        pwaInstallBtn.classList.add('flex');
      }
    });

    function triggerPwaInstall() {
      if (!deferredPrompt) return;
      deferredPrompt.prompt();
      deferredPrompt.userChoice.then((choiceResult) => {
        if (choiceResult.outcome === 'accepted' && pwaInstallBtn) {
          pwaInstallBtn.classList.add('hidden');
          pwaInstallBtn.classList.remove('flex');
        }
        deferredPrompt = null;
      });
    }

    function toggleOfflineModal() {
      if (!offlineModal) return;
      const isHidden = offlineModal.classList.contains('hidden');
      if (isHidden) {
        offlineModal.classList.remove('hidden');
        checkCacheReadiness();
      } else {
        offlineModal.classList.add('hidden');
      }
    }

    offlineModal?.addEventListener('click', (e) => {
      if (e.target === offlineModal) {
        toggleOfflineModal();
      }
    });

    async function checkCacheReadiness() {
      try {
        if (!('caches' in window)) return;
        const keys = await caches.keys();
        if (keys.length === 0) {
          if (offlineStatusDot) offlineStatusDot.className = 'w-2 h-2 rounded-full bg-slate-400';
          if (offlineStatusText) offlineStatusText.textContent = 'Save Offline';
          return;
        }

        const cache = await caches.open(keys[0]);
        const entries = await cache.keys();
        const count = entries.length;

        if (count >= 15) {
          if (offlineStatusDot) offlineStatusDot.className = 'w-2 h-2 rounded-full bg-emerald-500';
          if (offlineStatusText) offlineStatusText.textContent = `Offline Ready (${count})`;
          offlineSuccessAlert?.classList.remove('hidden');
        } else if (count > 0) {
          if (offlineStatusDot) offlineStatusDot.className = 'w-2 h-2 rounded-full bg-amber-500 animate-pulse';
          if (offlineStatusText) offlineStatusText.textContent = `Caching (${count})`;
        } else {
          if (offlineStatusDot) offlineStatusDot.className = 'w-2 h-2 rounded-full bg-slate-400';
          if (offlineStatusText) offlineStatusText.textContent = 'Save Offline';
        }
      } catch (e) {
        console.warn('Cache check error:', e);
      }
    }

    async function downloadAllOfflineAssets() {
      if (!('caches' in window)) {
        alert('Cache API is not supported in this browser.');
        return;
      }

      downloadAllAssetsBtn.disabled = true;
      downloadAllAssetsBtn.classList.add('opacity-70', 'cursor-not-allowed');
      downloadProgressContainer.classList.remove('hidden');
      offlineSuccessAlert?.classList.add('hidden');

      try {
        // Trigger Service Worker background cache sync
        const reg = await navigator.serviceWorker.ready;
        if (reg && reg.active) {
          reg.active.postMessage({ action: 'CACHE_ALL_ASSETS' });
        }
      } catch (err) {
        console.warn('SW trigger failed:', err);
      }
    }

    // Listen for progress from SW
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.addEventListener('message', (event) => {
        if (event.data && event.data.type === 'CACHE_PROGRESS') {
          const { current, total, url, done } = event.data;
          const pct = Math.round((current / total) * 100);
          if (downloadProgressBar) downloadProgressBar.style.width = pct + '%';
          if (downloadPercentText) downloadPercentText.textContent = pct + '%';
          if (downloadStatusText) downloadStatusText.textContent = `Caching: ${url.replace(/^.*[\\\/]/, '') || url}`;

          if (done) {
            if (downloadProgressBar) downloadProgressBar.style.width = '100%';
            if (downloadPercentText) downloadPercentText.textContent = '100%';
            if (downloadStatusText) downloadStatusText.textContent = 'اكتمل تنزيل كافة الأدوات والملفات بنجاح!';
            offlineSuccessAlert?.classList.remove('hidden');
            if (downloadAllAssetsBtn) {
              downloadAllAssetsBtn.disabled = false;
              downloadAllAssetsBtn.classList.remove('opacity-70', 'cursor-not-allowed');
            }
            checkCacheReadiness();
          }
        }
      });
    }

    async function clearOfflineCache() {
      if (!confirm('هل تريد حذف جميع الملفات المخزنة أوفلاين وإعادة تحميلها؟')) return;
      try {
        const keys = await caches.keys();
        for (const key of keys) {
          await caches.delete(key);
        }
        downloadProgressContainer?.classList.add('hidden');
        offlineSuccessAlert?.classList.add('hidden');
        if (downloadProgressBar) downloadProgressBar.style.width = '0%';
        checkCacheReadiness();
        alert('تم حذف الكاش بنجاح.');
      } catch (e) {
        console.error(e);
      }
    }

    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('sw.js').then(() => {
          checkCacheReadiness();
        }).catch((err) => {
          console.warn('[PWA] SW registration failed:', err);
        });
      });
    }

    window.addEventListener('online', checkCacheReadiness);
    window.addEventListener('offline', () => {
      if (offlineStatusDot) offlineStatusDot.className = 'w-2 h-2 rounded-full bg-emerald-500';
      if (offlineStatusText) offlineStatusText.textContent = 'Offline (Working)';
    });

    initTheme();
    checkCacheReadiness();
  </script>
</body>
</html>
